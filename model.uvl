namespace KostPLE

features
	KostPLE {abstract true}
		optional
			Payment {abstract true}
				or
					PaymentVA
					PaymentKredit
		mandatory
			KatalogKost {abstract true}
				mandatory
					InformasiKost
				optional
					PengajuanSurvey
			ProfilPengguna
			SewaKost {abstract true}
				or
					SewaViaApp
					SewaViaWa
		optional
			KostAktifPenyewa {abstract true}
				or
					InformasiTagihan
					PerpanjanganSewa
		mandatory
			PropertiPemilik {abstract true}
				mandatory
					DaftarProperti
				optional
					LaporanKeuangan

constraints
	SewaViaApp => Payment
	LaporanKeuangan => DaftarProperti & Payment & SewaViaApp
	KostAktifPenyewa => SewaViaApp & Payment
